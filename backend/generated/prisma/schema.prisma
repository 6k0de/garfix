generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String           @id @default(uuid())
  name      String
  email     String           @unique
  password  String?
  roleId    String
  companyId String?
  branchId  String?
  // Relaciones
  role      Role             @relation(fields: [roleId], references: [id])
  company   CustomerCompany? @relation(fields: [companyId], references: [id])
  branch    Branch?          @relation(fields: [branchId], references: [id])
  // Solicitudes creadas/asignadas
  services  Service[] // Si el usuario es técnico
  histories StatusHistory[]  @relation("ChangedBy")
}

model CustomerCompany {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  status    String // el estatus de la licencia, activa, inactiva, pausada, etc
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[] //sucursales
  users     User[]
}

model Branch {
  id              String           @id @default(uuid())
  name            String
  address         String
  companyId       String
  company         CustomerCompany  @relation(fields: [companyId], references: [id])
  clients         Client[]
  users           User[]
  serviceRequests ServiceRequest[]
  locations       Location[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Service {
  id               String   @id @default(uuid())
  serviceRequestId Int
  deviceTypeId     String
  brand            String
  model            String
  imei             String
  color            String
  appearance       String // estetica
  serviceDetail    String
  serviceSolution  String
  cost             Float
  advance          Float
  technicianId     String
  locationId       String
  deliveryDate     DateTime
  deliveryTime     String

  //Relaciones
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  deviceType     DeviceType     @relation(fields: [deviceTypeId], references: [id])
  technician     User?          @relation(fields: [technicianId], references: [id])
  location       Location?      @relation(fields: [locationId], references: [id])
  attachments    Attachment[]
}

model ServiceRequest {
  id            Int      @id @default(autoincrement()) // folio visible
  code          String   @unique //folio custom
  branchId      String
  clientId      String
  statusId      String
  qrCode        String   @unique
  receptionDate DateTime
  observations  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  branch      Branch          @relation(fields: [branchId], references: [id])
  client      Client          @relation(fields: [clientId], references: [id])
  status      Status          @relation(fields: [statusId], references: [id])
  services    Service[]
  histories   StatusHistory[]
  attachments Attachment[]
}

model StatusHistory {
  id               String   @id @default(uuid())
  serviceRequestId Int
  statusId         String
  changedById      String
  date             DateTime @default(now())

  //Relaciones
  status         Status         @relation(fields: [statusId], references: [id])
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  changedBy      User           @relation("ChangedBy", fields: [changedById], references: [id])
}

model Attachment {
  id          String   @id @default(uuid())
  url         String
  description String?
  createdAt   DateTime @default(now())

  //Relaciones
  service          Service?        @relation(fields: [serviceId], references: [id])
  serviceId        String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  serviceRequestId Int?
}

model Client {
  id              String           @id @default(uuid())
  name            String
  phone           String
  email           String
  address         String
  typeClientId    String
  documentTypeId  String
  branchId        String
  typeClient      TypeClient       @relation(fields: [typeClientId], references: [id])
  documentType    DocumentType     @relation(fields: [documentTypeId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  serviceRequests ServiceRequest[]
}

// Catalogos

model Role {
  id          String @id @default(uuid())
  name        String @unique // Admin, branch_user, etc
  description String
  users       User[]
}

model Status {
  id               String           @id @default(uuid())
  name             String           @unique // Recibido, En proceso, Entregado, etc
  description      String?
  histories        StatusHistory[]
  servicesRequests ServiceRequest[]
}

model Location {
  id          String    @id @default(uuid())
  name        String    @unique
  intructions String?
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  services    Service[]
}

model DeviceType {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  services    Service[]
}

model DocumentType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  clients     Client[]
}

model TypeClient {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  clients     Client[]
}
