generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String           @id @default(uuid())
  name        String
  email       String?          @unique
  username    String?          @unique
  password    String?
  isActive    Boolean          @default(true)
  roleId      String
  companyId   String?
  branchId    String?
  createdById String?
  // Relaciones
  role        Role             @relation(fields: [roleId], references: [id])
  company     CustomerCompany? @relation(fields: [companyId], references: [id])
  branch      Branch?          @relation(fields: [branchId], references: [id])
  createdBy   User?            @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]          @relation("UserCreatedBy")
  // Solicitudes creadas/asignadas
  services    Service[] // Si el usuario es técnico
  histories   StatusHistory[]  @relation("ChangedBy")
  sessions    AuthSession[]
}

model CustomerCompany {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  status           String // el estatus de la licencia, activa, inactiva, pausada, etc
  subscriptionPlan String   @default("BASIC")
  subscriptionPrice Float   @default(0)
  extraBranchPrices Float[] @default([])
  branchLimit      Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branches         Branch[] //sucursales
  users            User[]
  roles            Role[]
}

model AuthSession {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PublicSignupPayment {
  id                         String   @id @default(uuid())
  status                     String   @default("pending")
  mercadoPagoStatus          String?
  mercadoPagoStatusDetail    String?
  mercadoPagoPreferenceId    String?  @unique
  mercadoPagoPaymentId       String?  @unique
  mercadoPagoInitPoint       String?
  mercadoPagoSandboxInitPoint String?
  amount                     Float
  billingCycle               String   @default("monthly")
  subscriptionPlan           String
  companyName                String
  adminName                  String
  email                      String
  username                   String?
  passwordHash               String
  initialBranchName          String?
  initialBranchAddress       String?
  companyId                  String?
  userId                     String?
  rawPayment                 Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Branch {
  id              String           @id @default(uuid())
  name            String
  address         String
  companyId       String
  company         CustomerCompany  @relation(fields: [companyId], references: [id])
  clients         Client[]
  users           User[]
  serviceRequests ServiceRequest[]
  statuses        Status[]
  locations       Location[]
  deviceTypes     DeviceType[]
  documentTypes   DocumentType[]
  typeClients     TypeClient[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Service {
  id               String   @id @default(uuid())
  serviceRequestId Int
  deviceTypeId     String
  brand            String
  model            String
  imei             String
  color            String
  appearance       String // estetica
  unlockType       String   @default("") // PATTERN, PIN, PASSWORD, FINGERPRINT, FACE, NONE
  unlockCode       String   @default("") // código/patrón opcional
  serviceDetail    String
  serviceSolution  String
  cost             Float
  advance          Float
  technicianId     String
  locationId       String
  deliveryDate     DateTime
  deliveryTime     String

  //Relaciones
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  deviceType     DeviceType     @relation(fields: [deviceTypeId], references: [id])
  technician     User?          @relation(fields: [technicianId], references: [id])
  location       Location?      @relation(fields: [locationId], references: [id])
  attachments    Attachment[]
}

model ServiceRequest {
  id            Int      @id @default(autoincrement()) // folio visible
  code          String   @unique //folio custom
  branchId      String
  clientId      String
  statusId      String
  qrCode        String   @unique
  receptionDate DateTime
  observations  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  branch      Branch          @relation(fields: [branchId], references: [id])
  client      Client          @relation(fields: [clientId], references: [id])
  status      Status          @relation(fields: [statusId], references: [id])
  services    Service[]
  histories   StatusHistory[]
  attachments Attachment[]
  cancellation ServiceCancellation?
}

model StatusHistory {
  id               String   @id @default(uuid())
  serviceRequestId Int
  statusId         String
  changedById      String
  date             DateTime @default(now())

  //Relaciones
  status         Status         @relation(fields: [statusId], references: [id])
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  changedBy      User           @relation("ChangedBy", fields: [changedById], references: [id])
}

model Attachment {
  id          String   @id @default(uuid())
  url         String
  description String?
  createdAt   DateTime @default(now())

  //Relaciones
  service          Service?        @relation(fields: [serviceId], references: [id])
  serviceId        String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  serviceRequestId Int?
}

model Client {
  id              String           @id @default(uuid())
  name            String
  phone           String
  email           String
  address         String
  typeClientId    String?
  documentTypeId  String?
  branchId        String
  typeClient      TypeClient?      @relation(fields: [typeClientId], references: [id])
  documentType    DocumentType?    @relation(fields: [documentTypeId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  serviceRequests ServiceRequest[]
}

// Catalogos

model Role {
  id          String           @id @default(uuid())
  code        String           @unique @db.VarChar(50)
  name        String // Admin, branch_user, etc
  description String?
  companyId   String?
  company     CustomerCompany? @relation(fields: [companyId], references: [id])
  users       User[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Status {
  id               String           @id @default(uuid())
  name             String // Recibido, En proceso, Entregado, etc
  description      String?
  colorHex         String           @default("#64748B")
  branchId         String?
  branch           Branch?          @relation(fields: [branchId], references: [id])
  histories        StatusHistory[]
  servicesRequests ServiceRequest[]
  cancellations    ServiceCancellation[]

  @@unique([branchId, name])
  @@index([branchId])
}

model ServiceCancellation {
  id               String       @id @default(uuid())
  serviceRequestId Int          @unique
  statusId         String
  total            Float
  totalPaid        Float
  debt             Float
  amount           Float
  hasRefund        Boolean
  refundMethod     RefundMethod?
  cashFromBox      Boolean?
  bankAccount      String?
  bankFromBox      Boolean?
  sourceBoxName    String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  status         Status         @relation(fields: [statusId], references: [id])
}

enum RefundMethod {
  CASH
  BANK
}

model Location {
  id          String    @id @default(uuid())
  name        String
  intructions String?
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  services    Service[]

  @@unique([branchId, name])
}

model DeviceType {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean?  @default(true)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  services    Service[]

  @@unique([branchId, name])
}

model DocumentType {
  id          String   @id @default(uuid())
  name        String
  description String?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  clients     Client[]

  @@unique([branchId, name])
}

model TypeClient {
  id          String   @id @default(uuid())
  name        String
  description String?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  clients     Client[]

  @@unique([branchId, name])
}
