DATABASE_URL="postgresql://dev:dev1%21@localhost:5432/garfix?schema=public"
DATABASE_URL_PROD="postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/Garfix?schema=public&sslmode=require"
DATABASE_SSL=false
EVIDENCE_UPLOAD_DIR="uploads/services"
EVIDENCE_RETENTION_DAYS=1
EVIDENCE_CLEANUP_INTERVAL_MINUTES=60
EVIDENCE_CLEANUP_MIN_INTERVAL_MINUTES=10
EVIDENCE_MAX_FILES_PER_UPLOAD=6
EVIDENCE_MAX_FILE_SIZE_MB=10
EVIDENCE_MAX_WIDTH=1920
EVIDENCE_MAX_HEIGHT=1920
EVIDENCE_JPEG_QUALITY=70
FRONTEND_PUBLIC_URL="http://localhost:5173"
API_PUBLIC_URL="http://localhost:3001"
MERCADO_PAGO_PUBLIC_KEY="APP_USR_TU_PUBLIC_KEY"
MERCADO_PAGO_ACCESS_TOKEN="APP_USR_TU_ACCESS_TOKEN"
# Obligatorio en producción: sin este secreto el webhook se rechaza (NODE_ENV=production).
MERCADO_PAGO_WEBHOOK_SECRET="TU_WEBHOOK_SECRET"

# Entorno: en "production" se exigen SUPERADMIN_PASSWORD y el secreto del webhook.
NODE_ENV="development"

# Superadmin (obligatorios en producción)
SUPERADMIN_NAME="Superadmin Garfix"
SUPERADMIN_EMAIL="superadmin@garfix.local"
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_PASSWORD=""

# Rate limiting (valores por defecto razonables; opcional ajustarlos)
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_LOGIN=20
RATE_LIMIT_SIGNUP=10
RATE_LIMIT_CHECKOUT=15
RATE_LIMIT_WEBHOOK=60
RATE_LIMIT_EVIDENCE=30

# CAPTCHA (Cloudflare Turnstile). Si se deja vacío, la verificación se omite.
# Para activarlo: define este secreto y, en el frontend, VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=""
